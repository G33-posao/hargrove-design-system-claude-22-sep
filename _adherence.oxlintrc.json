{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/patterns/**",
              "ui_kits/portal/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|interactive|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, interactive, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|align|key|ref|className|style|children)$/]",
        "message": "<CheckItem> doesn't accept that prop. Declared props: children, size, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckItem'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|top)$/]",
        "message": "<CheckItem> align must be one of 'center' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommitmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|layout|key|ref|className|style|children)$/]",
        "message": "<CommitmentCard> doesn't accept that prop. Declared props: icon, title, children, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommitmentCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|stack)$/]",
        "message": "<CommitmentCard> layout must be one of 'row' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:onNavy|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: onNavy, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|overlap|children|key|ref|className|style|children)$/]",
        "message": "<IconChip> doesn't accept that prop. Declared props: size, overlap, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|basePath|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|priceNote|description|features|featuresLabel|cta|onCta|featured|key|ref|className|style|children)$/]",
        "message": "<PricingCard> doesn't accept that prop. Declared props: name, price, priceNote, description, features, featuresLabel, cta, onCta, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|size|align|onNavy|key|ref|className|style|children)$/]",
        "message": "<StatCallout> doesn't accept that prop. Declared props: value, label, size, align, onNavy."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatCallout> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|variant|onNavy|key|ref|className|style|children)$/]",
        "message": "<StepBadge> doesn't accept that prop. Declared props: n, variant, onNavy."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:circle|tab)$/]",
        "message": "<StepBadge> variant must be one of 'circle' | 'tab'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|title|firm|avatar|key|ref|className|style|children)$/]",
        "message": "<Testimonial> doesn't accept that prop. Declared props: quote, name, title, firm, avatar."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
